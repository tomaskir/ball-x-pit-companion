---
// Single-page companion site. Static shell + one interactive island
// (src/companion.ts). See CONTEXT.md for the domain glossary.
import '../styles/global.css';

// The game's own ball icon (from ballxpit.wiki.gg — see
// public/icons/CREDITS.md). Base-relative: the site deploys under
// /ball-x-pit-companion/ — and `base` is configured without a trailing
// slash, so the join adds it.
const faviconUrl = `${import.meta.env.BASE_URL}/favicon.ico`;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Fan companion for Ball x Pit: evolution recipes, synergy guides, and character quirks." />
    <link rel="icon" href={faviconUrl} />
    <title>Ball x Pit Companion</title>
  </head>
  <body>
    <header>
      <h1>Ball x Pit <span>Companion</span></h1>
      <span class="tab-sep" aria-hidden="true"></span>
      <nav class="tabs" aria-label="Sections">
        <button class="tab-btn active" data-section="balls">Balls</button>
        <button class="tab-btn" data-section="fusions">Fusions</button>
        <span class="tab-sep" aria-hidden="true"></span>
        <button class="tab-btn" data-section="passives">Passives</button>
        <span class="tab-sep" aria-hidden="true"></span>
        <button class="tab-btn" data-section="characters">Characters</button>
        <span class="tab-sep" aria-hidden="true"></span>
        <button class="tab-btn" data-section="plan">Plan</button>
      </nav>
      <div class="chips" id="charChips"></div>
      <span class="hint" id="slotHint"></span>
      <div class="header-right">
        <button id="themeToggle" aria-label="Toggle theme">☀️</button>
        <a class="repo-link" href="https://github.com/tomaskir/ball-x-pit-companion" aria-label="GitHub repository" target="_blank" rel="noopener noreferrer">
          <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true" fill="currentColor"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"/></svg>
        </a>
      </div>
    </header>

    <main>
      <div class="section-view" data-section="balls">
        <div class="screen-toolbar">
          <div id="selection-balls" class="selection-box" hidden></div>
          <input class="screen-search" data-section="balls" id="search-balls" type="search" placeholder="Search name or effect…" autocomplete="off" />
        </div>
        <div id="ballsGrid"></div>
      </div>
      <div class="section-view" data-section="passives" hidden>
        <div class="screen-toolbar">
          <div id="selection-passives" class="selection-box" hidden></div>
          <input class="screen-search" data-section="passives" id="search-passives" type="search" placeholder="Search name or effect…" autocomplete="off" />
        </div>
        <div id="passivesGrid"></div>
      </div>
      <div class="section-view" data-section="characters" hidden>
        <div class="screen-toolbar">
          <input class="screen-search" data-section="characters" id="search-characters" type="search" placeholder="Search name, quirk, or base ball…" autocomplete="off" />
        </div>
        <div id="charactersGrid" class="char-grid"></div>
      </div>
      <div class="section-view" data-section="fusions" hidden>
        <div class="fusion-layout">
          <div class="fusion-list-col">
            <input class="screen-search" data-section="fusions" id="search-fusions" type="search" placeholder="Search balls…" autocomplete="off" />
            <div id="fusionList" class="fusion-list" aria-label="Pick two balls to fuse"></div>
          </div>
          <div id="fusionPanel" class="fusion-panel"></div>
        </div>
      </div>
      <div class="section-view" data-section="plan" hidden>
        <div class="screen-toolbar plan-toolbar">
          <!-- the plan's action row: Clear left, End game upgrades right —
               share/link land here later -->
          <button id="planClear" class="plan-btn">Clear plan</button>
          <div id="planUpgradesSlot" class="plan-upgrades-slot"></div>
        </div>
        <div id="planView"></div>
      </div>
    </main>

    <footer>
      <p>
        Fan-made companion site. Ball x Pit © Kenny Sun (Kenomi LLC).
        Icons from <a href="https://ballxpit.wiki.gg/">ballxpit.wiki.gg</a> — see
        <a href="/ball-x-pit-companion/icons/CREDITS.md">credits</a>. Not affiliated with the rights holder.
      </p>
    </footer>

    <script>
      import '../companion';
    </script>
  </body>
</html>
